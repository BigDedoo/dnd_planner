# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12.3-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.13

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

ARG DND_PLANNER_BUILD_COMMIT

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN printf '%s' "${DND_PLANNER_BUILD_COMMIT}" \
    | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "${DND_PLANNER_BUILD_COMMIT}" > .dnd-planner-build-commit
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

FROM ${PYTHON_IMAGE} AS runtime

ENV APP_ENV=production \
    LOG_LEVEL=INFO \
    MUTATIONS_ENABLED=false \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 dndplanner \
    && useradd --system --uid 10001 --gid dndplanner --home-dir /app dndplanner

WORKDIR /app

COPY --from=builder --chown=dndplanner:dndplanner /app/.venv /app/.venv
COPY --from=builder --chown=dndplanner:dndplanner /app/.dnd-planner-build-commit /app/.dnd-planner-build-commit
COPY --chown=dndplanner:dndplanner alembic.ini ./
COPY --chown=dndplanner:dndplanner backend ./backend

USER dndplanner

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/test-health', timeout=3).read()"]

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
