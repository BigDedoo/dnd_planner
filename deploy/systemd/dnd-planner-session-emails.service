[Unit]
Description=DnD Planner important session email outbox
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/flock -n /run/lock/dnd-planner-session-emails.lock /usr/bin/docker exec deploy-backend-1 timeout --signal=TERM --kill-after=10s 270s python -m backend.cli.process_session_event_emails
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
