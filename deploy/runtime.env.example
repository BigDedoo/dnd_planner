# Copy only to /opt/apps/dnd-planner/runtime.env on the VPS and set mode 0600.
# Never commit the populated file.
DATABASE_URL=postgresql+psycopg://dnd_planner_app:REPLACE_WITH_URI_SAFE_PASSWORD@postgres:5432/dnd_planner
MUTATIONS_ENABLED=false
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
CLERK_SECRET_KEY=sk_live_REPLACE_WITH_CLERK_BACKEND_SECRET
CLERK_AUTHORIZED_PARTIES=["https://dnd-planner.dedoo.fr"]

# Transactional timed-session reminders only. Enable only after secure setup.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=support@dedoo.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@dedoo.fr
SMTP_FROM_NAME=DnD Planner
