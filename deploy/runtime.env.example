# Copy only to /opt/apps/dnd-planner/runtime.env on the VPS and set mode 0600.
# Never commit the populated file.
DATABASE_URL=postgresql+psycopg://dnd_planner_app:REPLACE_WITH_URI_SAFE_PASSWORD@postgres:5432/dnd_planner
MUTATIONS_ENABLED=false
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
