# Copy only to /opt/apps/dnd-planner/runtime.env on the VPS and set mode 0600.
# Never commit the populated file.
DATABASE_URL=postgresql+psycopg://dnd_planner_app:REPLACE_WITH_URI_SAFE_PASSWORD@postgres:5432/dnd_planner
MUTATIONS_ENABLED=false
APP_ENV=production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Phase 2A Clerk Authentication Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Optional explicit Issuer / JWKS URL overrides:
# CLERK_ISSUER=https://clerk.yourdomain.com
# CLERK_JWKS_URL=https://clerk.yourdomain.com/.well-known/jwks.json
