# Read by Next.js on the server only. Copy this file to frontend/.env.local.
# Do not rename this to a NEXT_PUBLIC_ variable.
API_UPSTREAM_URL=http://127.0.0.1:8000
# Server-only runtime contact link: mailto: or https:. Required before public beta.
# Blank/invalid values display a neutral unconfigured state.
SUPPORT_CONTACT_URL=
# Public legal-notice details, read by Next.js at runtime on the server.
# Leave blank in examples. Real operator identity must be reviewed before release.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_STATUS=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_PHONE=
# mailto: or https:, falls back to SUPPORT_CONTACT_URL when blank.
LEGAL_OPERATOR_CONTACT=
LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
