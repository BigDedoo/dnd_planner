# FastAPI configuration. Copy this file to .env in the repository root.
APP_ENV=development
LOG_LEVEL=INFO

# Active Phase 1C FastAPI/Alembic PostgreSQL target.
# The password below is for the loopback-only local Compose service and must
# never be reused in production.
DATABASE_URL=postgresql+psycopg://dnd_planner:dnd_planner_local_only@127.0.0.1:5432/dnd_planner
MUTATIONS_ENABLED=true

# Legacy rollback/tests and explicit importer source tooling only. Normal
# FastAPI requests never fall back to this SQLite path.
DATABASE_PATH=dnd_planner.db

# pydantic-settings expects a JSON array for list values.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Phase 2A Clerk Authentication Configuration
# In development, set your Clerk Secret Key or JWKS URL / Issuer.
# Backend verifies Clerk session tokens via JWKS / JWT signature.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional explicit Clerk Issuer / JWKS URL overrides:
# CLERK_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev
# CLERK_JWKS_URL=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
