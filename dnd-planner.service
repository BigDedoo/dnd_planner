[Unit]
Description=DnD Planner Application
After=network.target

[Service]
Type=simple
User=dedoo
WorkingDirectory=/home/dedoo/.gemini/antigravity/scratch/dnd_planner
ExecStart=/bin/bash /home/dedoo/.gemini/antigravity/scratch/dnd_planner/start_app.sh
Restart=on-failure
Environment=PATH=/usr/bin:/usr/local/bin
# Add any environment variables here if needed

[Install]
WantedBy=multi-user.target
